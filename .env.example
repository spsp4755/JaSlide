# Database (replace POSTGRES_PASSWORD before deployment)
POSTGRES_USER="jaslide"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
POSTGRES_DB="jaslide"
DATABASE_URL="postgresql://jaslide:replace-with-a-long-random-password@localhost:5432/jaslide?schema=public"
REDIS_URL="redis://localhost:6379"

# Internal LLM (OpenAI-compatible, Ollama, or vLLM)
# Configure an active LLM model in the admin UI with this endpoint/model, or
# provide these defaults for a single internal endpoint.
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_BASE_URL="http://llm.internal:8000/v1"

# JaSlide session and Keycloak SSO
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Use production only behind HTTPS because production session cookies are Secure.
NODE_ENV="development"
# The production SPA defaults to same-origin /api. Override only when the
# browser must call a different origin; the value is compiled into the image.
VITE_API_URL="/api"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
KEYCLOAK_ISSUER="https://keycloak.internal/realms/jaslide"
KEYCLOAK_CLIENT_ID="jaslide-web"
KEYCLOAK_CLIENT_SECRET=""
KEYCLOAK_REDIRECT_URI="https://jaslide.internal/api/auth/keycloak/callback"
KEYCLOAK_ADMIN_ROLES="jaslide-admin"

# Container release
JASLIDE_VERSION="v0.6.1"
WEB_PORT="3000"

# Storage (AWS S3)
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# Python Renderer Service
RENDERER_URL="http://localhost:8000"

# Credits
DEFAULT_FREE_CREDITS=100
CREDIT_PER_SLIDE=1
CREDIT_PER_IMAGE=5
CREDIT_PER_CHART=2
